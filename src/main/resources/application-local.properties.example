# =============================================================================
# Career Platform - local configuration example
# =============================================================================
#
# How to use
# ----------
# 1. Copy this file to the same directory and rename it to:
#        application-local.properties
#    (the real file is git-ignored and must never be committed)
# 2. Fill in your own local values below. Every value here is a placeholder.
# 3. Start the application with the "local" profile active:
#        mvnw spring-boot:run -Dspring-boot.run.profiles=local
#    or set the active profile in your IDE run configuration.
#
# Alternatively you can leave this file unused and provide the equivalent
# values as environment variables (see the README "Quick Start" section).
#
# Do not put real credentials in this example file.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# The JDBC URL below matches the default in application.properties.
# Change the host / port / database name if your MySQL differs.
spring.datasource.url=jdbc:mysql://localhost:3306/career_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
spring.datasource.username=<your-mysql-username>
spring.datasource.password=<your-mysql-password>


# -----------------------------------------------------------------------------
# JWT (required)
# -----------------------------------------------------------------------------
# Must be at least 32 bytes because it is used as an HMAC-SHA signing key.
# Generate one with:  openssl rand -base64 48
jwt.secret=<at-least-32-bytes-random-secret>
jwt.expiration-seconds=3600


# -----------------------------------------------------------------------------
# Chat AI - optional (disabled by default)
# -----------------------------------------------------------------------------
# Leave "enabled=false" to run the whole traditional business flow without any
# AI provider configured. The application still starts normally.
#
# When enabled, "provider" must be "openai" because DeepSeek is reached through
# an OpenAI-compatible adapter. The production chat model is fixed in code.
career-platform.ai.enabled=false
career-platform.ai.provider=none
career-platform.ai.api-key=
spring.ai.model.chat=none
spring.ai.openai.api-key=not-configured

# Example of a working local setup:
# career-platform.ai.enabled=true
# career-platform.ai.provider=openai
# career-platform.ai.api-key=<your-deepseek-api-key>
# spring.ai.model.chat=openai
# spring.ai.openai.api-key=<your-deepseek-api-key>


# -----------------------------------------------------------------------------
# External job search (Tavily) - optional (disabled by default)
# -----------------------------------------------------------------------------
# Required only for AI job discovery. The endpoint is a compile-time constant
# and cannot be overridden here.
career-platform.job-search.enabled=false
career-platform.job-search.api-key=

# Example:
# career-platform.job-search.enabled=true
# career-platform.job-search.api-key=<your-tavily-api-key>


# -----------------------------------------------------------------------------
# Embedding provider - optional (disabled by default)
# -----------------------------------------------------------------------------
# Required only for learning-material indexing and RAG question answering.
# The endpoint must be a full HTTPS /embeddings URL.
# "version" is part of the vector identity: change it whenever the model,
# endpoint or vector dimension changes, otherwise existing chunks will not be
# served as retrieval candidates and must be re-indexed.
career-platform.embedding.enabled=false
career-platform.embedding.endpoint=
career-platform.embedding.model=
career-platform.embedding.version=1
career-platform.embedding.api-key=

# Example:
# career-platform.embedding.enabled=true
# career-platform.embedding.endpoint=https://<your-embedding-host>/v1/embeddings
# career-platform.embedding.model=<your-embedding-model>
# career-platform.embedding.version=1
# career-platform.embedding.api-key=<your-embedding-api-key>


# -----------------------------------------------------------------------------
# Upload limits (optional, defaults shown)
# -----------------------------------------------------------------------------
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=6MB
